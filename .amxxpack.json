{
  "type": "amxmodx",
  "input": {
    "scripts": [
      { "dir": "./src/scripts" },
      { "dir": "./ext/EFK-Floating-Damage/source" }
    ],
    "include": "./src/include",
    "assets": ["./assets", "./.thirdparty/efk_assets"]
  },
  "output": {
    "base": "./dist",
    "scripts": "./addons/amxmodx/scripting",
    "plugins": "./addons/amxmodx/plugins",
    "include": "./addons/amxmodx/scripting/include",
    "assets": "./"
  },
  "thirdparty": {
    "dir": "./.thirdparty",
    "dependencies": [
      {
        "name": "reapi",
        "url": "https://github.com/s1lentq/reapi/releases/download/5.24.0.300/reapi-bin-5.24.0.300.zip"
      },
      {
        "name": "NextClientServerApi",
        "url": "https://github.com/CS-NextClient/NextClientServerApi/releases/download/v1.5.1/next_client_api.inc"
      },
      {
        "name": "efk_assets",
        "url": "https://www.dropbox.com/scl/fi/4s941jrbeenkau96inph8/efk_assets.zip?rlkey=dth0ou65a4537jec7anubmolh&dl=1"
      }
    ]
  },
  "include": [
    "./.thirdparty/reapi/addons/amxmodx/scripting/include",
    "./.thirdparty/NextClientServerApi/"
  ],
  "cli": {
    "templates": {
      "context": {
        "PLUGIN_VERSION": "1.0.0",
        "PLUGIN_AUTHOR": "AMXXPack"
      }
    }
  },
  "compiler": {
    "dir": "./.compiler",
    "version": "1.9",
    "addons": [],
    "executable": "amxxpc"
  }
}